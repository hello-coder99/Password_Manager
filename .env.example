# ==============================================================================
# AegisVault Self-Hosted Password Manager - Environment Configuration Example
# Copy to .env and replace all placeholder secrets before running in production.
# Never commit a real .env file to version control.
# ==============================================================================

# Flask Application Environment: development | testing | production
FLASK_ENV=development
FLASK_APP=wsgi:app

# Mandatory 256-bit (32+ bytes hex) secret key for signing session IDs and CSRF tokens
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-cryptographically-random-hex-secret-key

# MariaDB Configuration (used by docker-compose.yml and SQLAlchemy)
MYSQL_ROOT_PASSWORD=replace-with-strong-mariadb-root-password
MYSQL_DATABASE=aegisvault
MYSQL_USER=aegisvault_app
MYSQL_PASSWORD=replace-with-strong-mariadb-app-password
DATABASE_URL=mysql+pymysql://aegisvault_app:replace-with-strong-mariadb-app-password@mariadb:3306/aegisvault?charset=utf8mb4

# Redis Configuration (used for server-side Flask-Session and Flask-Limiter)
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0
RATELIMIT_STORAGE_URI=redis://:replace-with-strong-redis-password@redis:6379/1

# Cookie & Proxy Security Settings
# Set SESSION_COOKIE_SECURE=true in production behind HTTPS Nginx
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=30
TRUSTED_PROXY_COUNT=1

# Request Payload Limits (bytes)
MAX_CONTENT_LENGTH=524288

# Host Port Binding for Nginx Reverse Proxy
NGINX_HTTP_PORT=8080

# AI Studio Runtime Environment Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
